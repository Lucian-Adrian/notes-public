    {
      "id": "qYR-1x6Wfm0prijNH7ETY",
      "type": "text",
      "x": 800,
      "y": -820,
      "width": 202.11475487893452,
      "height": 90.90909090909093,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
