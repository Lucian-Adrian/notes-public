      "containerId": null,
      "originalText": "LLM model: gpt-4o",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "OIkYZU_eOGpBaI2ERRwBd",
      "type": "text",
      "x": 800,
      "y": -700,
      "width": 220.00000000000003,
      "height": 20.00000000000004,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
