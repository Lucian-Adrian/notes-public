    {
      "id": "EsEwGCnBNTsljzDH71m3o",
      "type": "text",
      "x": 800,
      "y": -100,
      "width": 202.11475487893452,
      "height": 63.636363636363654,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1x",
      "roundness": null,
      "seed": 537463987,
      "version": 222,
      "versionNonce": 347941907,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760445513114,
      "link": null,
      "locked": false,
      "text": "Overview\nThis system models a simple blogging platform. \nThe User is the actor who creates content. \nThe Blog acts as the primary container, holding Posts created\nby the user. \nEach Post is a unit of content that holds multiple Comments\nfrom other users. ",
      "fontSize": 7.272727272727275,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Overview\nThis system models a simple blogging platform. \nThe User is the actor who creates content. \nThe Blog acts as the primary container, holding Posts created by the user. \nEach Post is a unit of content that holds multiple Comments from other users. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "dByl5BbMc8fy4xPJEHskU",
      "type": "text",
      "x": 1020,
      "y": -100,
      "width": 219.99999999999991,
      "height": 78.26086956521736,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1xV",
      "roundness": null,
      "seed": 1127835421,
      "version": 319,
      "versionNonce": 1034709629,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760445499362,
      "link": null,
      "locked": false,
      "text": "The responsibilities:\nThe User object is the primary actor, it has content creation and authentication.\n\nThe Blog object is the main container,. It is responsible for holding a collection of posts and the blog's identity \n\nThe Post object represents a single unit of content. Its responsibility is to hold the article text and its related\ncomments.\n\nThe Comment object is the smallest unit, responsible for holding user feedback and has basic interaction like being\nedited.\n\nThese components work together in a hierarchy \nA User creates a Blog and Posts. The Blog aggregates the Posts, and each Post aggregates its Comments.\n\n",
      "fontSize": 4.17391304347826,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The responsibilities:\nThe User object is the primary actor, it has content creation and authentication.\n\nThe Blog object is the main container,. It is responsible for holding a collection of posts and the blog's identity \n\nThe Post object represents a single unit of content. Its responsibility is to hold the article text and its related comments.\n\nThe Comment object is the smallest unit, responsible for holding user feedback and has basic interaction like being edited.\n\nThese components work together in a hierarchy \nA User creates a Blog and Posts. The Blog aggregates the Posts, and each Post aggregates its Comments.\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
